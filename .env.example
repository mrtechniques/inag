# Server binding port
PORT=4000

# Server host interface (0.0.0.0 binds to all available adapters for local LAN)
HOST=0.0.0.0

# Administrator Security PIN for Admin Console operations
ADMIN_PIN=2025

# Environment
NODE_ENV=development

# Allowed CORS origins (comma-separated or * for local network)
ALLOWED_ORIGINS=*

# Session secret
SESSION_SECRET=yenartifica-cyber-secret-key-2025
